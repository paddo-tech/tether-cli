---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description?: string; }
const { title, description } = Astro.props;
const docSections = [
  { title: 'Get started', pages: [ ['Introduction', 'introduction'], ['Installation', 'installation'], ['Quick start', 'quick-start'], ['Upgrade to 2.0', 'upgrade'], ['Linux', 'linux'] ] },
  { title: 'Understand Tether', pages: [ ['How it works', 'how-it-works'], ['Encryption', 'encryption'], ['Package security', 'package-security'], ['Machine trust', 'machine-trust'], ['Machine profiles', 'machine-profiles'], ['Packages per profile', 'package-profiles'] ] },
  { title: 'Use Tether', pages: [ ['Dashboard', 'dashboard'], ['Commands', 'commands'], ['Scripts and -y', 'cmd-scripting'], ['Configuration', 'configuration'], ['Feature toggles', 'feature-toggles'] ] },
  { title: 'Connect your tools', pages: [ ['Package managers', 'package-managers'], ['Team sync', 'team-sync'], ['Troubleshooting', 'troubleshooting'] ] },
];
---

<BaseLayout title={title} description={description}>
  <div class="docs-shell wrap">
    <aside class="docs-sidebar"><p class="eyebrow">DOCUMENTATION</p><nav aria-label="Documentation sections">{docSections.map(section => <div><h2>{section.title}</h2><ul>{section.pages.map(([label, id]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul></div>)}</nav><a class="sidebar-source" href="https://github.com/paddo-tech/tether-cli">View source on GitHub ↗</a></aside>
    <main id="main" class="docs-content">
      <details class="docs-mobile-nav"><summary>On this page</summary><nav aria-label="Mobile documentation sections">{docSections.map(section => <div><strong>{section.title}</strong>{section.pages.map(([label, id]) => <a href={`#${id}`}>{label}</a>)}</div>)}</nav></details>
      <article class="prose"><slot /></article>
    </main>
  </div>
  <script>
    const menu = document.querySelector<HTMLDetailsElement>('.docs-mobile-nav')!;
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
  </script>
</BaseLayout>
