---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TeamDiagram from '../components/TeamDiagram.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import Code from '../components/Code.astro';
const commandGroups = [
  { title: 'Team setup', commands: [ ['tether team setup', 'Set up your team repository.'], ['tether team status', 'Check your team configuration.'] ] },
  { title: 'Organizations', commands: [ ['tether team orgs add <ORG>', 'Map an organization to your team.'], ['tether team orgs list', 'List mapped organizations.'], ['tether team orgs remove <ORG>', 'Remove an organization mapping.'] ] },
  { title: 'Project secrets', commands: [ ['tether team projects add .env', 'Share a project secret file.'], ['tether team projects list', 'List shared project files.'], ['tether team projects migrate', 'Move personal project secrets to your team.'], ['tether team projects purge-personal', 'Remove personal copies after migration.'] ] },
  { title: 'Recipient keys', commands: [ ['tether team secrets add-recipient <KEY>', 'Add a teammate’s public age key.'], ['tether team secrets list-recipients', 'List the recipient keys.'], ['tether team secrets remove-recipient <NAME>', 'Remove a named recipient.'] ] },
  { title: 'Team secrets', commands: [ ['tether team secrets set <NAME>', 'Set a named team secret.'], ['tether team secrets get <NAME>', 'Read a named team secret.'] ] },
];
---

<BaseLayout title="Team sync — Tether CLI" description="Share team dotfiles and encrypted project secrets through Git. Each teammate uses their own age key.">
  <main id="main">
    <section class="page-hero wrap"><div><p class="eyebrow"><Icon name="users" size={16} /> SAME TEAM. SHARED SETUP.</p><h1>Share the setup.<br /><em>Keep your keys.</em></h1><p class="lede">Give your team the configs and project secrets they need. Tether connects their machines through your team’s Git repository.</p><div class="hero-actions"><a class="button primary" href="#team-setup">Set up your team <Icon name="arrow" size={18} /></a><a class="text-link" href="/security">See the security model ↗</a></div><p class="availability">Git backed · age encryption · Individual keys</p></div><TeamDiagram /></section>
    <section class="package-band team-principles wrap"><span>BUILT AROUND YOUR WORKFLOW</span><div><strong>Your Git repo</strong><strong>Your projects</strong><strong>Your recipients</strong></div></section>
    <section class="setup-section wrap" id="team-setup"><div class="section-heading"><p class="eyebrow">CONNECT YOUR TEAM</p><h2>From a shared repo<br />to a shared environment.</h2></div><ol class="setup-steps"><li><span class="step-number">1</span><h3>Set up the team.</h3><p>Connect a team repository and create your age identity. Add each teammate’s public key as a recipient.</p><Code code="tether team setup" /></li><li><span class="step-number">2</span><h3>Map your organization.</h3><p>Associate your GitHub organization with the team. Tether uses that mapping to find the right team.</p><Code code="tether team orgs add github.com/your-org" /></li><li><span class="step-number">3</span><h3>Share a project file.</h3><p>Run this command from your project. Tether encrypts the file for the configured recipients.</p><Code code="tether team projects add .env" /></li></ol></section>
    <section class="content-section wrap"><div class="section-heading"><p class="eyebrow">MATCH THE PROJECT, NOT THE FOLDER</p><h2>Different paths.<br />The same project.</h2><p>Tether matches projects by Git remote URL. Your teammate can keep their checkout in a different directory.</p></div><FlowDiagram label="PROJECT SECRET SHARING" caption="Recipients need repository access and a matching private age key." steps={[
      { icon: 'file', title: 'Select a project file', detail: '.env in your local checkout' },
      { icon: 'lock', title: 'Encrypt for the team', detail: 'Public age keys select recipients' },
      { icon: 'laptop', title: 'Apply on their machine', detail: 'Match the project’s Git remote' },
    ]} /><div class="detail-columns"><article><div class="feature-symbol"><Icon name="key" /></div><h3>One key per person.</h3><p>Each teammate has their own age identity. Add their public key so they can decrypt shared secrets.</p></article><article><div class="feature-symbol"><Icon name="git" /></div><h3>Personal settings stay personal.</h3><p>Keep personal configuration alongside your team setup.</p></article><article><div class="feature-symbol"><Icon name="users" /></div><h3>Work with collaborators.</h3><p>Use collab secrets for project sharing based on GitHub collaborators. Enable the feature for projects that need it.</p><a class="text-link" href="/docs/team-sync#collab">Read about collab secrets ↗</a></article></div></section>
    <section class="command-section wrap" id="commands"><div class="section-heading"><p class="eyebrow">THE COMMANDS YOU NEED</p><h2>Manage your team<br />from your terminal.</h2></div><div class="command-groups">{commandGroups.map(group => <section><h3>{group.title}</h3><dl>{group.commands.map(([command, description]) => <div><dt><code>{command}</code></dt><dd>{description}</dd></div>)}</dl></section>)}</div></section>
    <section class="team-callout wrap"><Icon name="users" size={31} /><div><p class="eyebrow">READY TO CONNECT</p><h2>Give your team<br />a common starting point.</h2><p>Start with team setup. Choose what to share.</p></div><a class="button primary" href="/docs/team-sync">Read the team guide <Icon name="arrow" size={18} /></a></section>
  </main>
</BaseLayout>
