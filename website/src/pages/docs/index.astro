  <!-- Configuration -->
  <section id="configuration">
    <h2>Configuration</h2>
    <p>Configuration lives at <code>~/.tether/config.toml</code>:</p>
    <Code code={`[backend]
url = "git@github.com:username/dotfiles.git"

[security]
encrypt_dotfiles = true
scan_secrets = true

[dotfiles]
files = [".zshrc", ".gitconfig", ".vimrc"]
dirs = [".config/nvim", ".ssh/config"]

[project_configs]
enabled = true
search_paths = ["~/Projects", "~/Work"]
patterns = [".env.local", ".claude/settings.json"]

[packages]
min_release_age_days = 7          # 0 turns the limit off
allow_scripts = ["esbuild"]       # Packages that may run install scripts
auto_install_from_trusted = true  # false holds every synced package

[packages.brew]
enabled = true
sync_casks = true
trusted_taps = ["oven-sh/bun"]    # Taps outside homebrew/*

[packages.npm]
enabled = true

[packages.pnpm]
enabled = false

[packages.bun]
enabled = false

[packages.gem]
enabled = false`} />

    <h3>Key Configuration Options</h3>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-surface">
          <th class="text-left py-2 pr-4">Key</th>
          <th class="text-left py-2">Description</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">backend.url</td>
          <td class="py-2">Git repository URL</td>
        </tr>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">security.encrypt_dotfiles</td>
          <td class="py-2">Enable AES-256-GCM encryption</td>
        </tr>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">security.scan_secrets</td>
          <td class="py-2">Enable secret detection before sync</td>
        </tr>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">dotfiles.files</td>
          <td class="py-2">List of individual dotfiles to sync</td>
        </tr>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">dotfiles.dirs</td>
          <td class="py-2">List of directories to sync</td>
        </tr>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">project_configs.enabled</td>
          <td class="py-2">Sync project-local configs</td>
        </tr>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">packages.*.enabled</td>
          <td class="py-2">Enable specific package manager sync</td>
        </tr>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">packages.min_release_age_days</td>
          <td class="py-2">Skip npm, pnpm, bun and uv releases newer than this many days. Default 7. 0 turns it off</td>
        </tr>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">packages.allow_scripts</td>
          <td class="py-2">Packages that may run install scripts. Scripts are off for all other npm, pnpm and bun packages</td>
        </tr>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">packages.auto_install_from_trusted</td>
          <td class="py-2">Install packages from trusted machine records without a question. Default true</td>
        </tr>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">packages.brew.trusted_taps</td>
          <td class="py-2">Homebrew taps outside <code>homebrew/*</code> that Tether may install from</td>
        </tr>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">packages.brew.sync_casks</td>
          <td class="py-2">Sync Homebrew casks. Tether never installs casks on Linux</td>
        </tr>
        <tr class="border-b border-surface/50">
          <td class="py-2 pr-4 font-mono text-xs">dashboard.theme</td>
          <td class="py-2">Dashboard colors: <code>auto</code>, <code>mocha</code>, <code>latte</code>, or <code>ansi</code></td>
        </tr>
      </tbody>
    </table>
    <p>The dashboard Config tab can also edit the package security settings.</p>

    <h3 id="local-config">Settings for one machine</h3>
    <p><code>~/.tether/local.toml</code> holds settings for this machine only. Tether never syncs it. Its values override <code>config.toml</code> on this machine.</p>
    <Code lang="toml" code={`[packages]
min_release_age_days = 14

[merge]
command = "vimdiff"
args = ["{local}", "{remote}", "{merged}"]   # The default when args is missing`} />
  </section>

