#!/usr/bin/env python3
"""Fake brew, npm, pnpm, bun, gem, ruby, uv and curl for the e2e suite.

Installed packages live in /state/pkgs/<key> as "name version" lines, seeded per
machine. Every call is appended to /state/calls.jsonl with the round it ran in, and
each install records whether the package was already installed, so the test can
count reinstalls. Nothing touches the network.
"""
import json
import os
import sys

STATE = "/state"
REGISTRY_VERSION = "1.0.0"
OLD_RELEASE = "2020-01-01T00:00:00Z"


def read_round():
    try:
        with open(f"{STATE}/round") as f:
            return f.read().strip()
    except OSError:
        return "?"


def installed(key):
    pkgs = {}
    try:
        with open(f"{STATE}/pkgs/{key}") as f:
            for line in f:
                parts = line.split()
                if parts:
                    pkgs[parts[0]] = parts[1] if len(parts) > 1 else REGISTRY_VERSION
    except OSError:
        pass
    return pkgs


def write(key, pkgs):
    os.makedirs(f"{STATE}/pkgs", exist_ok=True)
    with open(f"{STATE}/pkgs/{key}", "w") as f:
        for name in sorted(pkgs):
            f.write(f"{name} {pkgs[name]}\n")


INSTALLS = []
UNINSTALLS = []


def install(key, name, version, spec):
    pkgs = installed(key)
    INSTALLS.append({"key": key, "name": name, "spec": spec, "already": name in pkgs})
    pkgs[name] = version or REGISTRY_VERSION
    write(key, pkgs)


def uninstall(key, name):
    pkgs = installed(key)
    UNINSTALLS.append({"key": key, "name": name, "present": name in pkgs})
    pkgs.pop(name, None)
    write(key, pkgs)


def positional(args, takes_value=()):
    out, skip = [], False
    for a in args:
        if skip:
            skip = False
        elif a in takes_value:
            skip = True
        elif not a.startswith("-"):
            out.append(a)
    return out


def split_npm(spec):
    at = spec.find("@", 1)
    return (spec, None) if at < 0 else (spec[:at], spec[at + 1:])


def npm_like(tool, args):
    key = tool
    if args[:1] == ["--version"]:
        return {"npm": "11.12.0", "pnpm": "10.28.0", "bun": "1.3.5"}[tool]
    if args[:2] == ["config", "get"]:
        return "https://registry.npmjs.org/" if args[2:3] == ["registry"] else "undefined"
    if args[:2] == ["list", "-g"]:
        deps = {n: {"version": v} for n, v in installed(key).items()}
        return json.dumps([{"dependencies": deps}] if tool == "pnpm" else {"dependencies": deps})
    if args[:3] == ["pm", "ls", "-g"]:
        pkgs = installed(key)
        lines = [f"/root/.bun/install/global node_modules ({len(pkgs)})"]
        lines += [f"├── {n}@{v}" for n, v in pkgs.items()]
        return "\n".join(lines)
    if args[:1] in (["install"], ["i"], ["add"]) and "-g" in args:
        for spec in positional(args[1:]):
            name, version = split_npm(spec)
            install(key, name, version, spec)
        return ""
    if args[:1] in (["uninstall"], ["remove"]) and "-g" in args:
        for name in positional(args[1:]):
            uninstall(key, name)
        return ""
    if args[:1] == ["outdated"]:
        return "{}" if tool != "bun" else ""
    return ""


def gem(args):
    if args[:1] == ["--version"]:
        return "3.6.2"
    if args[:1] == ["list"]:
        return "\n".join(installed("gem"))
    if args[:1] == ["install"]:
        for spec in positional(args[1:], ("-v", "--version")):
            name, _, version = spec.partition(":")
            install("gem", name, version or None, spec)
    return ""


def ruby(args):
    script = args[1] if args[:1] == ["-e"] and len(args) > 1 else ""
    if "latest[n]" in script:
        return "\n".join(f"{n} {v}" for n, v in installed("gem").items())
    if "Gem::Specification" in script:
        return "\n".join(installed("gem"))
    return "3.4.7"


def uv(args):
    if args[:1] == ["--version"] or args[:2] == ["self", "version"]:
        return "uv 0.9.20"
    if args[:2] == ["python", "find"]:
        return "3.12.3"
    if args[:2] == ["tool", "list"]:
        if "--outdated" in args:
            return ""
        return "\n".join(f"{n} v{v}\n    - {n}" for n, v in installed("uv").items())
    if args[:2] == ["tool", "install"]:
        for spec in positional(args[2:], ("--exclude-newer", "--python", "--with", "--from", "--index-url")):
            name, _, version = spec.partition("==")
            install("uv", name, version or None, spec)
    return ""


def brewfile_install(path):
    with open(path) as f:
        for line in f:
            parts = line.split(None, 1)
            if len(parts) < 2:
                continue
            name = parts[1].strip().split(",")[0].strip('"')
            key = {"brew": "brew_formulae", "cask": "brew_casks", "tap": "brew_taps"}.get(parts[0])
            if key:
                install(key, name, None, f"{parts[0]} {name}")


def brew(args):
    a = " ".join(args)
    if a == "--version":
        return "Homebrew 4.6.0"
    if a in ("--repository", "--prefix"):
        return "/home/linuxbrew/.linuxbrew"
    if a == "--cellar":
        return "/home/linuxbrew/.linuxbrew/Cellar"
    if a == "--caskroom":
        return "/home/linuxbrew/.linuxbrew/Caskroom"
    if a.startswith("list --formula") :
        return "\n".join(installed("brew_formulae"))
    if a == "list --versions":
        return "\n".join(f"{n} {v}" for n, v in installed("brew_formulae").items())
    if a == "list --cask -1":
        return "\n".join(installed("brew_casks"))
    if a == "tap":
        return "\n".join(installed("brew_taps"))
    if args[:1] == ["tap"] and len(args) > 1:
        install("brew_taps", args[1], None, args[1])
        return ""
    if args[:2] == ["bundle", "dump"]:
        lines = [f'tap "{n}"' for n in installed("brew_taps")]
        lines += [f'brew "{n}"' for n in installed("brew_formulae")]
        lines += [f'cask "{n}"' for n in installed("brew_casks")]
        with open(args[-1], "w") as f:
            f.write("\n".join(lines) + "\n")
        return ""
    if args[:2] == ["bundle", "install"]:
        brewfile_install(args[-1])
        return ""
    if args[:2] == ["info", "--json=v2"]:
        cask = "--cask" in args
        names = positional(args[2:])
        if not names:
            return json.dumps({"formulae": [], "casks": []})
        n = names[0]
        tap = n.rsplit("/", 1)[0] if n.count("/") == 2 else ("homebrew/cask" if cask else "homebrew/core")
        base = n.rsplit("/", 1)[-1]
        if cask:
            return json.dumps({"formulae": [], "casks": [{"token": base, "full_token": n, "tap": tap, "version": REGISTRY_VERSION, "installed": None}]})
        return json.dumps({"formulae": [{"name": base, "full_name": n, "tap": tap, "versions": {"stable": REGISTRY_VERSION}}], "casks": []})
    if args[:1] == ["install"]:
        key = "brew_casks" if "--cask" in args else "brew_formulae"
        for n in positional(args[1:]):
            install(key, n, None, n)
        return ""
    if args[:1] == ["outdated"]:
        return json.dumps({"formulae": [], "casks": []})
    return ""


def curl(args):
    url = args[-1]
    if "api.osv.dev" in url:
        body = json.loads(sys.stdin.read() or "{}")
        return json.dumps({"results": [{} for _ in body.get("queries", [])]})
    if "registry.npmjs.org/" in url:
        return json.dumps({
            "dist-tags": {"latest": REGISTRY_VERSION},
            "versions": {REGISTRY_VERSION: {}},
            "time": {REGISTRY_VERSION: OLD_RELEASE},
        })
    if "pypi.org/pypi/" in url:
        return json.dumps({"releases": {REGISTRY_VERSION: [{"yanked": False, "upload_time_iso_8601": OLD_RELEASE}]}})
    if "rubygems.org/api/v1/versions/" in url:
        return json.dumps([{"number": REGISTRY_VERSION, "prerelease": False}])
    sys.stderr.write(f"curl: (6) e2e shim has no network: {url}\n")
    sys.exit(6)


def main():
    tool = os.path.basename(sys.argv[0])
    args = sys.argv[1:]
    handler = {"brew": brew, "gem": gem, "ruby": ruby, "uv": uv, "curl": curl}.get(tool)
    try:
        out = handler(args) if handler else npm_like(tool, args)
    finally:
        entry = {"r": read_round(), "tool": tool, "argv": args}
        if INSTALLS:
            entry["installs"] = INSTALLS
        if UNINSTALLS:
            entry["uninstalls"] = UNINSTALLS
        with open(f"{STATE}/calls.jsonl", "a") as f:
            f.write(json.dumps(entry) + "\n")
    if out:
        print(out)


main()
